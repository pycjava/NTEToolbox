{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NTEToolbox",
  "version": "2.0.0",
  "identifier": "com.ntetoolbox.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build && pnpm prepare:maafw"
  },
  "app": {
    "windows": [
      {
        "title": "异环工具箱",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "resources": {
      "gen/maafw/": "maafw/",
      "gen/hscoach/": "hscoach/",
      "gen/WebView2Loader.dll": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
