{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaaToolbox Client",
  "version": "0.0.0",
  "identifier": "com.ntetoolbox.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MaaToolbox",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
