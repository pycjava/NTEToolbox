{
   "interface_version": 2,
   "name": "NTEToolbox",
   "description": "异环工具箱",
   "license": "AGPLv3",
   "github": "https://github.com/op200/NTEToolbox",
   "version": "1.9.0",
   "resource": [
      {
         "name": "默认",
         "path": ["./resource"]
      }
   ],
   "agent": {
      "child_exec": "python",
      "child_args": ["-u", "-m", "agent"]
   },
   "controller": [
      {
         "name": "Win PostMessage (默认)",
         "type": "Win32",
         "permission_required": true,
         "win32": {
            "class_regex": "UnrealWindow",
            "window_regex": "^\\s*(异环|NTE)\\s*$",
            "screencap": "FramePool",
            "mouse": "Seize",
            "keyboard": "PostMessage"
         }
      },
      {
         "name": "Win PostMessageWithWindowPos",
         "type": "Win32",
         "permission_required": true,
         "win32": {
            "class_regex": "UnrealWindow",
            "window_regex": "^\\s*(异环|NTE)\\s*$",
            "screencap": "FramePool",
            "mouse": "Seize",
            "keyboard": "PostMessageWithWindowPos"
         }
      },
      {
         "name": "Win Seize",
         "type": "Win32",
         "win32": {
            "class_regex": "UnrealWindow",
            "window_regex": "^\\s*(异环|NTE)\\s*$",
            "screencap": "FramePool",
            "mouse": "Seize",
            "keyboard": "Seize"
         }
      },
      {
         "name": "Mac",
         "type": "MacOS",
         "macos": {
            "title_regex": "^\\s*(异环|NTE)\\s*$",
            "screencap": "ScreenCaptureKit",
            "input": "PostToPid"
         }
      },
      {
         "name": "ADB",
         "type": "Adb"
      }
   ],
   "task": [
      {
         "name": "全局设置",
         "entry": "全局设置",
         "option": ["全局设置"]
      },
      {
         "name": "钓鱼",
         "entry": "钓鱼",
         "option": [
            "钓鱼终止时间开关",
            "溜鱼设置",
            "卖鱼买换饵开关",
            "卖鱼买换饵设置"
         ]
      },
      {
         "name": "弹钢琴 (键盘输入)",
         "entry": "弹钢琴_keybord",
         "option": ["弹钢琴_keybord_设置"]
      },
      {
         "name": "实时辅助",
         "entry": "实时辅助",
         "option": [
            "实时辅助_自动拾取",
            "实时辅助_自动拾取_永远拾取",
            "实时辅助_S级鱼截图",
            "实时辅助_S级鱼截图_设置"
         ]
      }
   ],
   "option": {
      "全局设置": {
         "type": "input",
         "inputs": [
            {
               "name": "debug_mode_switch",
               "label": "debug 模式开关 (`1` 为开 `0` 为关)",
               "pipeline_type": "int",
               "default": "0"
            },
            {
               "name": "logging_switch",
               "label": "日志开关 (`1` 为开 `0` 为关)",
               "description": "关闭后 debug 目录不再写入 maafw 运行时日志。本质上是修改 maa_option.json 的 `logging`，所以重启后才能生效",
               "pipeline_type": "int",
               "default": "1"
            }
         ],
         "pipeline_override": {
            "全局设置": {
               "action": {
                  "param": {
                     "custom_action_param": {
                        "debug_mode_switch": "{debug_mode_switch}",
                        "logging_switch": "{logging_switch}"
                     }
                  }
               }
            }
         }
      },
      "钓鱼终止时间开关": {
         "type": "switch",
         "label": "终止时间",
         "description": "启用后可通过下拉列表选择钓鱼持续时长；到达时间后终止该节点",
         "cases": [
            {
               "name": "Yes",
               "option": [
                  "钓鱼终止时长"
               ],
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "终止时间开关": true
                     }
                  }
               }
            },
            {
               "name": "No",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "终止时间开关": false
                     }
                  }
               }
            }
         ],
         "default_case": "No"
      },
      "钓鱼终止时长": {
         "type": "select",
         "label": "钓鱼时长",
         "cases": [
            {
               "name": "30分钟",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "终止时长": 30
                     }
                  }
               }
            },
            {
               "name": "1小时",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "终止时长": 60
                     }
                  }
               }
            },
            {
               "name": "2小时",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "终止时长": 120
                     }
                  }
               }
            },
            {
               "name": "3小时",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "终止时长": 180
                     }
                  }
               }
            },
            {
               "name": "4小时",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "终止时长": 240
                     }
                  }
               }
            },
            {
               "name": "6小时",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "终止时长": 360
                     }
                  }
               }
            },
            {
               "name": "8小时",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "终止时长": 480
                     }
                  }
               }
            },
            {
               "name": "12小时",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "终止时长": 720
                     }
                  }
               }
            }
         ],
         "default_case": "2小时"
      },
      "溜鱼设置": {
         "type": "input",
         "inputs": [
            {
               "name": "溜鱼_midpoint_pix_range",
               "label": "溜鱼中点停顿范围 (pix)",
               "pipeline_type": "int",
               "default": "5"
            },
            {
               "name": "溜鱼_midpoint_sleep_time",
               "label": "溜鱼中点停顿时间 (ms)",
               "pipeline_type": "int",
               "default": "5"
            }
         ],
         "pipeline_override": {
            "钓鱼": {
               "attach": {
                  "溜鱼_midpoint_pix_range": "{溜鱼_midpoint_pix_range}",
                  "溜鱼_midpoint_sleep_time": "{溜鱼_midpoint_sleep_time}"
               }
            }
         }
      },
      "卖鱼买换饵开关": {
         "type": "switch",
         "label": "自动卖鱼买换饵 (抢占鼠标)",
         "description": "无饵或满舱时，按顺序执行 `卖鱼` `买饵` `换饵`。由于涉及点击操作，会抢占鼠标",
         "cases": [
            {
               "name": "Yes",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "卖鱼买换饵开关": true
                     }
                  }
               }
            },
            {
               "name": "No",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "卖鱼买换饵开关": false
                     }
                  }
               }
            }
         ],
         "default_case": "No"
      },
      "卖鱼买换饵设置": {
         "type": "input",
         "inputs": [
            {
               "name": "买饵次数",
               "label": "买饵次数",
               "description": "次数 `n` 代表买 `n * 99` 个饵",
               "pipeline_type": "int",
               "default": "4"
            }
         ],
         "pipeline_override": {
            "钓鱼": {
               "attach": {
                  "买饵次数": "{买饵次数}"
               }
            }
         }
      },
      "弹钢琴_keybord_设置": {
         "type": "input",
         "inputs": [
            {
               "name": "midi_path",
               "label": "MIDI 文件路径",
               "pipeline_type": "string"
            },
            {
               "name": "bpm",
               "label": "默认 BPM",
               "pipeline_type": "string"
            },
            {
               "name": "piano_mode",
               "label": "钢琴模式 (只能填 `21` 或 `36`)",
               "pipeline_type": "string",
               "default": "36"
            },
            {
               "name": "timeout_mode",
               "label": "超时模式 (只能填 `同步时轴` 或 `速率不变`)",
               "pipeline_type": "string",
               "default": "速率不变"
            },
            {
               "name": "use_custom_winapi",
               "label": "使用自定义的 WinAPI (`1` 为开 `0` 为关)",
               "description": "使用自定义的 WinAPI 代替 maafw 的键盘输入 API, 以解决输入延迟问题。会导致指针光标闪烁但不会抢占鼠标",
               "pipeline_type": "int",
               "default": "1"
            }
         ],
         "pipeline_override": {
            "弹钢琴_keybord": {
               "action": {
                  "param": {
                     "custom_action_param": {
                        "midi_path": "{midi_path}",
                        "bpm": "{bpm}",
                        "piano_mode": "{piano_mode}",
                        "timeout_mode": "{timeout_mode}",
                        "use_custom_winapi": "{use_custom_winapi}"
                     }
                  }
               }
            }
         }
      },
      "实时辅助_自动拾取": {
         "type": "switch",
         "label": "自动拾取",
         "description": "自动按 F 键拾取。自动判断画面内容决定是否拾取",
         "cases": [
            {
               "name": "Yes",
               "pipeline_override": {
                  "实时辅助": {
                     "attach": {
                        "自动拾取": true
                     }
                  }
               }
            },
            {
               "name": "No",
               "pipeline_override": {
                  "实时辅助": {
                     "attach": {
                        "自动拾取": false
                     }
                  }
               }
            }
         ],
         "default_case": "Yes"
      },
      "实时辅助_自动拾取_永远拾取": {
         "type": "switch",
         "label": "自动拾取 - 永远拾取",
         "description": "永远拾取，**不判断**画面内容。**按住 F** 时关闭 `自动拾取`。适合粉爪等场景（注意避开盔甲等）。仅在启用 `自动拾取` 时有效",
         "cases": [
            {
               "name": "Yes",
               "pipeline_override": {
                  "实时辅助": {
                     "attach": {
                        "永远拾取": true
                     }
                  }
               }
            },
            {
               "name": "No",
               "pipeline_override": {
                  "实时辅助": {
                     "attach": {
                        "永远拾取": false
                     }
                  }
               }
            }
         ],
         "default_case": "No"
      },
      "实时辅助_S级鱼截图": {
         "type": "switch",
         "label": "S级鱼截图",
         "description": "识别到金色背景光和 S 图标时，自动保存当前截图",
         "cases": [
            {
               "name": "Yes",
               "pipeline_override": {
                  "实时辅助": {
                     "attach": {
                        "S级鱼截图": true
                     }
                  }
               }
            },
            {
               "name": "No",
               "pipeline_override": {
                  "实时辅助": {
                     "attach": {
                        "S级鱼截图": false
                     }
                  }
               }
            }
         ],
         "default_case": "Yes"
      },
      "实时辅助_S级鱼截图_设置": {
         "type": "input",
         "inputs": [
            {
               "name": "S级鱼截图保存目录",
               "label": "S级鱼截图保存目录",
               "pipeline_type": "string",
               "default": "screenshots/s_fish"
            },
            {
               "name": "S级鱼截图冷却时间",
               "label": "S级鱼截图冷却时间 (秒)",
               "pipeline_type": "int",
               "default": "5"
            }
         ],
         "pipeline_override": {
            "实时辅助": {
               "attach": {
                  "S级鱼截图保存目录": "{S级鱼截图保存目录}",
                  "S级鱼截图冷却时间": "{S级鱼截图冷却时间}"
               }
            }
         }
      }
   }
}
