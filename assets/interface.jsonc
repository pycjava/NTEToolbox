      "溜鱼设置": {
         "type": "input",
         "inputs": [
            {
               "name": "溜鱼_midpoint_pix_range",
               "label": "溜鱼中点停顿范围 (pix)",
               "pipeline_type": "int",
               "default": "5"
            },
            {
               "name": "溜鱼_midpoint_sleep_time",
               "label": "溜鱼中点停顿时间 (ms)",
               "pipeline_type": "int",
               "default": "5"
            }
         ],
         "pipeline_override": {
            "钓鱼": {
               "attach": {
                  "溜鱼_midpoint_pix_range": "{溜鱼_midpoint_pix_range}",
                  "溜鱼_midpoint_sleep_time": "{溜鱼_midpoint_sleep_time}"
               }
            }
         }
      },
      "卖鱼买换饵开关": {
         "type": "switch",
         "label": "自动卖鱼买换饵 (抢占鼠标)",
         "description": "无饵或满舱时，按顺序执行 `卖鱼` `买饵` `换饵`。由于涉及点击操作，会抢占鼠标",
         "cases": [
            {
               "name": "Yes",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "卖鱼买换饵开关": true
                     }
                  }
               }
            },
            {
               "name": "No",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "卖鱼买换饵开关": false
                     }
                  }
               }
            }
         ],
         "default_case": "No"
      },
      "卖鱼买换饵设置": {
         "type": "input",
         "inputs": [
            {
               "name": "买饵次数",
               "label": "买饵次数",
               "description": "次数 `n` 代表买 `n * 99` 个饵",
               "pipeline_type": "int",
               "default": "4"
            }
         ],
         "pipeline_override": {
            "钓鱼": {
               "attach": {
                  "买饵次数": "{买饵次数}"
               }
            }
         }
      },
      "弹钢琴_keybord_设置": {
         "type": "input",
         "inputs": [
            {
               "name": "midi_path",
               "label": "MIDI 文件路径",
               "pipeline_type": "string"
            },
            {
               "name": "bpm",
               "label": "默认 BPM",
               "pipeline_type": "string"
            },
            {
               "name": "piano_mode",
               "label": "钢琴模式 (只能填 `21` 或 `36`)",
               "pipeline_type": "string",
               "default": "36"
            },
            {
               "name": "timeout_mode",
               "label": "超时模式 (只能填 `同步时轴` 或 `速率不变`)",
               "pipeline_type": "string",
               "default": "速率不变"
            },
            {
               "name": "use_custom_winapi",
               "label": "使用自定义的 WinAPI (`1` 为开 `0` 为关)",
               "description": "使用自定义的 WinAPI 代替 maafw 的键盘输入 API, 以解决输入延迟问题。会导致指针光标闪烁但不会抢占鼠标",
               "pipeline_type": "int",
               "default": "1"
            }
         ],
         "pipeline_override": {
            "弹钢琴_keybord": {
               "action": {
                  "param": {
                     "custom_action_param": {
                        "midi_path": "{midi_path}",
                        "bpm": "{bpm}",
                        "piano_mode": "{piano_mode}",
                        "timeout_mode": "{timeout_mode}",
                        "use_custom_winapi": "{use_custom_winapi}"
                     }
                  }
               }
            }
         }
      },
      "实时辅助_自动拾取": {
         "type": "switch",
         "label": "自动拾取",
         "description": "自动按 F 键拾取。自动判断画面内容决定是否拾取",
         "cases": [
            {
               "name": "Yes",
               "pipeline_override": {
                  "实时辅助": {
                     "attach": {
                        "自动拾取": true
                     }
                  }
               }
            },
            {
               "name": "No",
               "pipeline_override": {
                  "实时辅助": {
                     "attach": {
                        "自动拾取": false
                     }
                  }
               }
            }
         ],
         "default_case": "Yes"
      },
      "实时辅助_自动拾取_永远拾取": {
         "type": "switch",
         "label": "自动拾取 - 永远拾取",
         "description": "永远拾取，**不判断**画面内容。**按住 F** 时关闭 `自动拾取`。适合粉爪等场景（注意避开盔甲等）。仅在启用 `自动拾取` 时有效",
         "cases": [
            {
               "name": "Yes",
               "pipeline_override": {
                  "实时辅助": {
                     "attach": {
                        "永远拾取": true
                     }
                  }
               }
            },
            {
               "name": "No",
               "pipeline_override": {
                  "实时辅助": {
                     "attach": {
                        "永远拾取": false
                     }
                  }
               }
            }
         ],
         "default_case": "No"
      },
      "实时辅助_S级鱼截图": {
         "type": "switch",
         "label": "S级鱼截图",
         "description": "识别到金色背景光和 S 图标时，自动保存当前截图",
         "cases": [
            {
               "name": "Yes",
               "pipeline_override": {
                  "实时辅助": {
                     "attach": {
                        "S级鱼截图": true
                     }
                  }
               }
            },
            {
               "name": "No",
               "pipeline_override": {
                  "实时辅助": {
                     "attach": {
                        "S级鱼截图": false
                     }
                  }
               }
            }
         ],
         "default_case": "Yes"
      },
      "实时辅助_S级鱼截图_设置": {
         "type": "input",
         "inputs": [
            {
               "name": "S级鱼截图保存目录",
               "label": "S级鱼截图保存目录",
               "pipeline_type": "string",
               "default": "screenshots/s_fish"
            },
            {
               "name": "S级鱼截图冷却时间",
               "label": "S级鱼截图冷却时间 (秒)",
               "pipeline_type": "int",
               "default": "5"
            }
         ],
         "pipeline_override": {
            "实时辅助": {
               "attach": {
                  "S级鱼截图保存目录": "{S级鱼截图保存目录}",
                  "S级鱼截图冷却时间": "{S级鱼截图冷却时间}"
               }
            }
         }
      }
   }
}
