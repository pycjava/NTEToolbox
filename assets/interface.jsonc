{
   "interface_version": 2,
   "name": "NTEToolbox",
   "description": "异环工具箱",
   "license": "AGPLv3",
   "github": "https://github.com/op200/NTEToolbox",
   "version": "1.8.1",
   "resource": [
      {
         "name": "默认",
         "path": ["./resource"]
      }
   ],
   "agent": {
      "child_exec": "python",
      "child_args": ["-u", "-m", "agent"]
   },
   "controller": [
      {
         "name": "Win PostMessage (默认)",
         "type": "Win32",
         "permission_required": true,
         "win32": {
            "class_regex": "UnrealWindow",
            "window_regex": "^\\s*(异环|NTE)\\s*$",
            "screencap": "FramePool",
            "mouse": "Seize",
            "keyboard": "PostMessage"
         }
      },
      {
         "name": "Win PostMessageWithWindowPos",
         "type": "Win32",
         "permission_required": true,
         "win32": {
            "class_regex": "UnrealWindow",
            "window_regex": "^\\s*(异环|NTE)\\s*$",
            "screencap": "FramePool",
            "mouse": "Seize",
            "keyboard": "PostMessageWithWindowPos"
         }
      },
      {
         "name": "Win Seize",
         "type": "Win32",
         "win32": {
            "class_regex": "UnrealWindow",
            "window_regex": "^\\s*(异环|NTE)\\s*$",
            "screencap": "FramePool",
            "mouse": "Seize",
            "keyboard": "Seize"
         }
      },
      {
         "name": "Mac",
         "type": "MacOS",
         "macos": {
            "title_regex": "^\\s*(异环|NTE)\\s*$",
            "screencap": "ScreenCaptureKit",
            "input": "PostToPid"
         }
      },
      {
         "name": "ADB",
         "type": "Adb"
      }
   ],
   "task": [
      {
         "name": "全局设置",
         "entry": "全局设置",
         "option": ["全局设置"]
      },
      {
         "name": "钓鱼",
         "entry": "钓鱼",
         "option": [
            "钓鱼终止时间开关",
            "溜鱼设置",
            "卖鱼买换饵开关",
            "卖鱼买换饵设置"
         ]
      },
      {
         "name": "弹钢琴 (键盘输入)",
         "entry": "弹钢琴_keybord",
         "option": ["弹钢琴_keybord_设置"]
      },
      {
         "name": "实时辅助",
         "entry": "实时辅助",
         "option": [
            "实时辅助_自动拾取",
            "实时辅助_自动拾取_永远拾取",
            "实时辅助_S级鱼截图",
            "实时辅助_S级鱼截图_设置"
         ]
      }
   ],
   "option": {
      "全局设置": {
         "type": "input",
         "inputs": [
            {
               "name": "debug_mode_switch",
               "label": "debug 模式开关 (`1` 为开 `0` 为关)",
               "pipeline_type": "int",
               "default": "0"
            },
            {
               "name": "logging_switch",
               "label": "日志开关 (`1` 为开 `0` 为关)",
               "description": "关闭后 debug 目录不再写入 maafw 运行时日志。本质上是修改 maa_option.json 的 `logging`，所以重启后才能生效",
               "pipeline_type": "int",
               "default": "1"
            }
         ],
         "pipeline_override": {
            "全局设置": {
               "action": {
                  "param": {
                     "custom_action_param": {
                        "debug_mode_switch": "{debug_mode_switch}",
                        "logging_switch": "{logging_switch}"
                     }
                  }
               }
            }
         }
      },
      "钓鱼终止时间开关": {
         "type": "switch",
         "label": "终止时间",
         "description": "启用后可通过下拉列表选择年月日时分秒；到达时间后终止该节点。如果选择的时间早于当前时间，自动顺延到最近的未来时间",
         "cases": [
            {
               "name": "Yes",
               "option": [
                  "钓鱼终止年",
                  "钓鱼终止月",
                  "钓鱼终止日",
                  "钓鱼终止时",
                  "钓鱼终止分",
                  "钓鱼终止秒"
               ],
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "终止时间开关": true
                     }
                  }
               }
            },
            {
               "name": "No",
               "pipeline_override": {
                  "钓鱼": {
                     "attach": {
                        "终止时间开关": false
                     }
                  }
               }
            }
         ],
         "default_case": "No"
      },
